---
import { getCollection } from "astro:content";

const username = "dreamkeeperhu";
const selectedProjects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .map((project) => ({
    name: project.data.title,
    summary: project.data.summary,
    techStack: project.data.techStack,
    repo: project.data.repo,
    url: project.data.url,
  }));
---

<section id="github" class="split-section reveal">
  <div class="section-head">
    <h2>GitHub Live</h2>
    <p>Recent repositories and contribution traces, kept close to the actual work rather than a polished project gallery.</p>
  </div>

  <div class="github-grid">
    <article class="github-live-panel">
      <div class="panel-kicker">Contributions</div>
      <div class="contrib-summary" data-contrib-summary>Loading contribution graph...</div>
      <div class="contrib-graph" data-contrib-graph aria-label="GitHub contribution graph"></div>
    </article>

    <article class="github-live-panel">
      <div class="panel-kicker">Latest repositories</div>
      <div class="repo-list" data-github-repos>
        <p class="muted">Loading repositories from GitHub...</p>
      </div>
    </article>
  </div>
</section>

<script is:inline define:vars={{ username, selectedProjects }}>
  const repoTarget = document.querySelector("[data-github-repos]");
  const graphTarget = document.querySelector("[data-contrib-graph]");
  const summaryTarget = document.querySelector("[data-contrib-summary]");

  const escapeHtml = (value) =>
    String(value || "").replace(/[&<>"']/g, (char) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;",
    }[char]));

  async function loadRepos() {
    if (!repoTarget) return;
    try {
      const repoQuery = selectedProjects.map((project) => project.repo).filter(Boolean).slice(0, 8).map((repo) => `${username}/${repo}`).join(",");
      const response = await fetch(`/api/github-repos?repos=${encodeURIComponent(repoQuery)}`);
      if (!response.ok) throw new Error("GitHub cache unavailable");
      const fallbackByName = new Map(selectedProjects.map((project) => [project.name, project]));
      const payload = await response.json();
      const repos = (payload.repos || [])
        .filter((repo) => /^[A-Za-z0-9_.-]+$/.test(repo.name) && repo.name !== "-")
        .slice(0, 6)
        .map((repo) => ({ ...repo, fallback: fallbackByName.get(repo.name) }));

      repoTarget.innerHTML = repos.map((repo, index) => `
        <a class="repo-row" href="${repo.htmlUrl}" target="_blank" rel="noreferrer">
          <span>${String(index + 1).padStart(2, "0")}</span>
          <strong>${escapeHtml(repo.name)}</strong>
          <small>${escapeHtml(repo.description || repo.fallback?.summary || "Public code and experiment notes.")}</small>
          <em>${escapeHtml(repo.language || repo.fallback?.techStack?.[0] || "Code")} · ${repo.stars ?? "?"} stars · ${repo.updatedAt ? new Date(repo.updatedAt).toISOString().slice(0, 10) : repo.source}</em>
        </a>
      `).join("");
    } catch {
      repoTarget.innerHTML = selectedProjects.map((repo, index) => `
        <a class="repo-row" href="${repo.url}" target="_blank" rel="noreferrer">
          <span>${String(index + 1).padStart(2, "0")}</span>
          <strong>${escapeHtml(repo.name)}</strong>
          <small>${escapeHtml(repo.summary)}</small>
          <em>${escapeHtml(repo.techStack?.[0] || "Code")} · curated fallback</em>
        </a>
      `).join("");
    }
  }

  async function loadContributions() {
    if (!graphTarget || !summaryTarget) return;
    try {
      const response = await fetch(`https://github-contributions-api.jogruber.de/v4/${username}?y=last`);
      if (!response.ok) throw new Error("Contribution API unavailable");
      const data = await response.json();
      const days = data.contributions || [];
      summaryTarget.textContent = `${data.total?.lastYear ?? 0} contributions in the last year`;
      graphTarget.innerHTML = days.map((day) => `
        <span class="contrib-cell level-${day.level}" title="${day.date}: ${day.count} contributions"></span>
      `).join("");
    } catch {
      summaryTarget.textContent = "Contribution graph is temporarily unavailable";
      graphTarget.innerHTML = "";
    }
  }

  loadRepos();
  loadContributions();
</script>
