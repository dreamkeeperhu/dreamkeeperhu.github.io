---
import { profile } from "../data/profile";

const action = import.meta.env.PUBLIC_SUBSCRIBE_ACTION || "/api/subscribe";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<form class="subscribe-form" data-subscribe-form data-action={action}>
  <label for="subscribe-email">Subscribe to notes</label>
  <input class="subscribe-honey" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div>
    <input id="subscribe-email" name="email" type="email" inputmode="email" placeholder="you@example.com" required />
    <button type="submit">Notify me</button>
  </div>
  {turnstileSiteKey && (
    <div class="turnstile-field">
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
    </div>
  )}
  <p data-subscribe-message>
    New notes are occasional. I will only send updates when there is something worth reading.
  </p>
</form>

{turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script is:inline define:vars={{ action, email: profile.email }}>
  const form = document.querySelector("[data-subscribe-form]");
  const message = document.querySelector("[data-subscribe-message]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const formData = new FormData(form);
    const address = String(formData.get("email") || "").trim();
    if (!address) return;
    if (message) message.textContent = "Saving your email...";

    try {
      const response = await fetch(action, {
        method: "POST",
        body: formData,
        headers: { Accept: "application/json" },
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || payload.ok === false) throw new Error(payload.error || "Subscription failed");
      if (message) {
        const status = payload.message || "Subscribed. I will only send updates when there is something worth reading.";
        message.innerHTML = payload.unsubscribeUrl
          ? `${escapeHtml(status)} <a href="${payload.unsubscribeUrl}">Unsubscribe anytime</a>. <button type="button" data-copy-unsubscribe="${escapeHtml(payload.unsubscribeUrl)}">Copy unsubscribe link</button>`
          : escapeHtml(status);
      }
      form.reset();
      resetTurnstile(form);
    } catch {
      if (message) message.innerHTML = `Subscription is not responding. Email <a href="mailto:${email}">${email}</a> directly and I will add you manually.`;
      resetTurnstile(form);
    }
  });

  message?.addEventListener("click", async (event) => {
    const button = event.target?.closest?.("[data-copy-unsubscribe]");
    if (!button) return;
    try {
      await navigator.clipboard.writeText(button.dataset.copyUnsubscribe || "");
      button.textContent = "Copied";
    } catch {
      button.textContent = "Copy failed";
    }
  });

  function escapeHtml(value) {
    return String(value || "").replace(/[&<>"']/g, (char) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;",
    }[char]));
  }

  function resetTurnstile(scope) {
    const widget = scope?.querySelector?.(".cf-turnstile");
    if (widget && window.turnstile?.reset) window.turnstile.reset(widget);
  }
</script>
