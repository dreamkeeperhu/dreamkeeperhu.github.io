---
import { getCollection } from "astro:content";
import { entrySlug } from "../utils/content";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const researchRoadmap = (await getCollection("roadmap"))
  .filter((item) => !item.data.draft)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
---

<section class={`roadmap-section reveal${compact ? " compact-roadmap" : ""}`} aria-label="Research roadmap">
  <div class="section-head compact-head">
    <h2>Research Roadmap</h2>
    <p>Three public threads organize the work: instruction, transfer, and the larger question of what the next robotics paradigm should look like.</p>
  </div>
  <div class="roadmap-grid">
    {researchRoadmap.map((item, index) => (
      <article id={entrySlug(item.id)}>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <h3>{item.data.title}</h3>
        <p>{item.data.question}</p>
        <dl>
          <dt>Now</dt>
          <dd>{item.data.now}</dd>
          <dt>Next</dt>
          <dd>{item.data.next}</dd>
        </dl>
        <div class="inline-links">
          {item.data.links.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </article>
    ))}
  </div>
</section>
