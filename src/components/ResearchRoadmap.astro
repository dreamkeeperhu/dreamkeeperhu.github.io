---
import { researchRoadmap } from "../data/roadmap";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section class={`roadmap-section reveal${compact ? " compact-roadmap" : ""}`} aria-label="Research roadmap">
  <div class="section-head compact-head">
    <h2>Research Roadmap</h2>
    <p>Three public threads organize the work: instruction, transfer, and the larger question of what the next robotics paradigm should look like.</p>
  </div>
  <div class="roadmap-grid">
    {researchRoadmap.map((item, index) => (
      <article id={item.slug}>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <h3>{item.title}</h3>
        <p>{item.question}</p>
        <dl>
          <dt>Now</dt>
          <dd>{item.now}</dd>
          <dt>Next</dt>
          <dd>{item.next}</dd>
        </dl>
        <div class="inline-links">
          {item.links.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </article>
    ))}
  </div>
</section>
