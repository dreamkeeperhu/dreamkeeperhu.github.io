---
import { getCollection } from "astro:content";
import { timelineSortValue } from "../utils/content";

const notes = (await getCollection("notes")).filter((note) => !note.data.draft);
const papers = (await getCollection("papers")).filter((paper) => !paper.data.draft);
const projects = (await getCollection("projects")).filter((project) => !project.data.draft);
const library = (await getCollection("library")).filter((item) => !item.data.draft);
const milestones = (await getCollection("timeline")).filter((item) => !item.data.draft);
const artifactCount = [
  ...papers.flatMap((paper) => paper.data.artifacts),
  ...projects.flatMap((project) => project.data.artifacts),
  ...library.flatMap((item) => item.data.artifacts),
].length;
const repoNames = projects.map((project) => project.data.repo).filter(Boolean).slice(0, 8);
const latestUpdate = milestones
  .sort((a, b) => timelineSortValue(b.data.date).localeCompare(timelineSortValue(a.data.date)))[0]?.data.date || "2026";
---

<section class="site-pulse reveal" aria-label="Site pulse">
  <div>
    <span class="eyebrow">Site Pulse</span>
    <h2>Small signals that this place is alive.</h2>
  </div>
  <div class="pulse-grid">
    <article>
      <span>Public notes</span>
      <strong>{notes.length}</strong>
    </article>
    <article>
      <span>Research items</span>
      <strong>{papers.length}</strong>
    </article>
    <article>
      <span>Projects</span>
      <strong>{projects.length}</strong>
    </article>
    <article>
      <span>Library items</span>
      <strong>{library.length}</strong>
    </article>
    <article>
      <span>Evidence links</span>
      <strong>{artifactCount}</strong>
    </article>
    <article>
      <span>Latest update</span>
      <strong class="pulse-date">{latestUpdate}</strong>
    </article>
    <article>
      <span>Total visits</span>
      <strong data-site-views>--</strong>
    </article>
    <article>
      <span>Today</span>
      <strong data-site-views-today>--</strong>
    </article>
    <article>
      <span>GitHub cache</span>
      <strong class="pulse-date" data-github-signal>--</strong>
    </article>
  </div>
</section>

<script is:inline define:vars={{ repoNames }}>
  const githubSignal = document.querySelector("[data-github-signal]");
  const views = document.querySelector("[data-site-views]");
  const viewsToday = document.querySelector("[data-site-views-today]");

  fetch("/api/site-stats")
    .then((response) => response.json())
    .then((stats) => {
      if (!stats.ok) return;
      const visits = new Intl.NumberFormat().format(stats.views || 0);
      const today = new Intl.NumberFormat().format(stats.viewsToday || 0);
      if (views) views.textContent = visits;
      if (viewsToday) viewsToday.textContent = today;
    })
    .catch(() => {});

  const repoQuery = repoNames.map((repo) => `dreamkeeperhu/${repo}`).join(",");
  fetch(repoQuery ? `/api/github-repos?repos=${encodeURIComponent(repoQuery)}` : "/api/github-repos?repos=dreamkeeperhu/dreamkeeperhu.github.io")
    .then((response) => (response.ok ? response.json() : []))
    .then((payload) => {
      const repo = (payload.repos || []).sort((a, b) => String(b.updatedAt || "").localeCompare(String(a.updatedAt || "")))[0];
      if (repo && githubSignal) {
        githubSignal.textContent = `${repo.name} · ${repo.updatedAt ? new Date(repo.updatedAt).toISOString().slice(0, 10) : repo.source}`;
      }
    })
    .catch(() => {});
</script>
