---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubscribeForm from "../components/SubscribeForm.astro";
import SitePulse from "../components/SitePulse.astro";
import ResearchRoadmap from "../components/ResearchRoadmap.astro";
import EvidenceBadges from "../components/EvidenceBadges.astro";
import { getCollection } from "astro:content";
import { profile } from "../data/profile";
import { asset } from "../utils/cdn";
import { entryUpdatedValue, evidenceCount, noteHref, paperHref, projectHref, sortSelectedWork, timelineSortValue } from "../utils/content";

const latestNotes = (await getCollection("notes"))
  .filter((note) => !note.data.draft)
  .sort((a, b) => entryUpdatedValue(b) - entryUpdatedValue(a))
  .slice(0, 2);
const allPapers = (await getCollection("papers"))
  .filter((paper) => !paper.data.draft);
const allProjects = (await getCollection("projects"))
  .filter((project) => !project.data.draft);
const allLibrary = (await getCollection("library"))
  .filter((item) => !item.data.draft);
const latestPapers = allPapers
  .filter((paper) => !paper.data.draft)
  .sort((a, b) => entryUpdatedValue(b) - entryUpdatedValue(a))
  .slice(0, 1);
const featuredProjects = sortSelectedWork(allProjects.filter((project) => project.data.featured))
  .slice(0, 3);
const currentSignal = latestPapers[0] || featuredProjects[0];
const totalArtifacts = [
  ...allPapers.flatMap((paper) => paper.data.artifacts),
  ...allProjects.flatMap((project) => project.data.artifacts),
  ...allLibrary.flatMap((item) => item.data.artifacts),
].length;
const latestUpdated = [...latestNotes, ...allPapers, ...allProjects, ...allLibrary]
  .sort((a, b) => entryUpdatedValue(b) - entryUpdatedValue(a))[0];
const latestWork = [
  ...latestNotes.map((note) => ({
    type: "note",
    title: note.data.title,
    description: note.data.description,
    href: noteHref(note),
    date: note.data.updatedDate || note.data.pubDate,
    meta: `${note.data.category}${note.data.series ? ` · ${note.data.series}` : ""}`,
    evidence: 0,
  })),
  ...allPapers.map((paper) => ({
    type: "research",
    title: paper.data.title,
    description: paper.data.abstract,
    href: paperHref(paper),
    date: paper.data.updatedDate || new Date(`${paper.data.year}-01-01`),
    meta: `${paper.data.status} · ${paper.data.year}`,
    evidence: evidenceCount(paper),
  })),
  ...allProjects.map((project) => ({
    type: "project",
    title: project.data.title,
    description: project.data.summary,
    href: projectHref(project),
    date: project.data.updatedDate || new Date("2026-01-01"),
    meta: `${project.data.status} · ${project.data.statusDetail}`,
    evidence: evidenceCount(project),
  })),
].sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf()).slice(0, 6);
const latestFilterLabels = {
  note: "Notes",
  research: "Research",
  project: "Projects",
};
const latestFilters = [
  ["all", "All"],
  ...Array.from(new Set(latestWork.map((item) => item.type))).map((type) => [type, latestFilterLabels[type] || type]),
];
const contactIntents = [
  ["research", "Research", "Robotics / sim-to-real discussion"],
  ["project", "Project", "Tooling or implementation feedback"],
  ["research feedback", "Research Feedback", "Questions about CCHIHH status or reproducibility"],
  ["general", "General", "A direct note or conversation"],
];
const latestMilestones = (await getCollection("timeline"))
  .filter((item) => !item.data.draft && item.data.featured)
  .sort((a, b) => timelineSortValue(b.data.date).localeCompare(timelineSortValue(a.data.date)) || a.data.order - b.data.order)
  .slice(0, 3);
const homeSearchSuggestions = ["robotics", "sim-to-real", "CCHIHH"];
const visitorPaths = [
  ["/research/map", "Research Map", "See how papers, projects, notes, and roadmap threads connect."],
  ["/projects", "Project Index", "Inspect runnable work, experiments, and implementation traces."],
  ["/now", "Now Page", "Check the current focus without reading the whole archive."],
];
const homeHeroImage = asset("/assets/internal-beyond-bg-canvas.png");
---

<BaseLayout current="Home" title="HJH | dreamkeeperhu">
  <section class="hero-section" aria-label="Personal poster">
    <div class="flip-shell">
      <div class="flip-inner">
        <div class="flip-front">
          <div class="hero-title water-hero" data-reveal-zone>
            <img class="hero-media" src={homeHeroImage} alt="" width="2600" height="1351" decoding="async" fetchpriority="high" />
            <canvas class="hero-fog" aria-hidden="true"></canvas>
            <h1>Jianheng Hu</h1>
            <div class="hero-focus">
              <span>Welcome</span>
              <strong>General physical intelligence</strong>
              <p>Robotics instruction, sim-to-real generalization, and the next robotics paradigm. Public work here is organized by status, evidence, code traces, and notes.</p>
              <div class="hero-actions">
                <a class="button-primary" href="/research">Research</a>
                <a class="button-secondary" href="/research/map">Map</a>
                <a class="button-secondary" href={`mailto:${profile.email}`}>Email</a>
              </div>
            </div>
            <div class="hero-strip" aria-label="Homepage summary">
              <span>Welcome / HJH / Beihang University</span>
              <span>Robotics instruction · Sim-to-real · New robotics paradigm</span>
              <span>{profile.email}</span>
            </div>
            <div class="alt-layer" aria-hidden="true">
              <h2>你好，我是 HJH</h2>
              <span class="about-label">About Me</span>
            </div>
            <button class="about-trigger" type="button" aria-label="Open about card"></button>
          </div>
        </div>

        <div class="flip-back" aria-label="About me">
          <div class="back-content">
            <div class="about-copy">
              <p>我长期想做的事，是把智能带向 general physical intelligence：让它不只会回答问题，也能在真实物理世界里理解任务、采取行动，并可靠泛化。</p>
              <p>现在我更具体地关注两件事：让机器人更容易被清楚地指令，以及让仿真中学到的能力更稳地迁移到真实机器人上。</p>
              <p>这里会持续收纳我的工具、算法实验、界面原型，以及我对下一代机器人范式的思考。</p>
              <p><strong>HJH</strong></p>
            </div>
          </div>
          <button class="back-close" type="button" aria-label="Return to title"></button>
        </div>
      </div>
    </div>
  </section>

  <section class="showcase" aria-label="Selected directions">
    <a class="showcase-card" href="/research">
      <img src={asset("/assets/interface-field.png")} alt="Interface structure and flowing curves" width="1200" height="700" decoding="async" fetchpriority="high" />
      <span class="showcase-overlay"></span>
      <span class="showcase-info">
        <strong>Robotics Instruction</strong>
        <small>让机器人更好理解任务与意图</small>
      </span>
    </a>
    <a class="showcase-card" href="/research">
      <img src={asset("/assets/agent-map.png")} alt="Node network and automation workflow" width="1200" height="700" loading="lazy" decoding="async" />
      <span class="showcase-overlay"></span>
      <span class="showcase-info">
        <strong>Sim-to-real</strong>
        <small>让仿真经验更稳地迁移到真实世界</small>
      </span>
    </a>
    <a class="showcase-card" href="/notes">
      <img src={asset("/assets/signal-wave.png")} alt="Waveform and signal record" width="1200" height="700" loading="lazy" decoding="async" />
      <span class="showcase-overlay"></span>
      <span class="showcase-info">
        <strong>New Robotics Paradigm</strong>
        <small>探索下一代机器人范式</small>
      </span>
    </a>
  </section>

  <section class="signal-band" aria-label="Profile summary">
    <a href={`mailto:${profile.email}`}>
      <span>Email</span>
      <strong>{profile.email}</strong>
    </a>
    <a href="/cv">
      <span>CV</span>
      <strong>Resume PDF & Preview</strong>
    </a>
    <a href="/notes">
      <span>Writing</span>
      <strong>Notes & Research Logs</strong>
    </a>
  </section>

  <section class="home-tools" aria-label="Useful homepage shortcuts">
    <form class="home-search" action="/search" method="get">
      <label for="home-search-input">Find anything</label>
      <div class="home-search-row">
        <input id="home-search-input" name="q" type="search" placeholder="Search notes, projects, research..." />
        <button type="submit">Search</button>
      </div>
      <p>Search the generated site index across notes, research pages, projects, tags, and library entries.</p>
      <div class="home-search-suggestions" aria-label="Suggested searches">
        {homeSearchSuggestions.map((query) => <a href={`/search?q=${encodeURIComponent(query)}`}>{query}</a>)}
      </div>
    </form>

    <div class="home-contact-tool">
      <span>Contact shortcut</span>
      <strong>{profile.email}</strong>
      <div class="home-copy-actions">
        <button type="button" data-copy-value={profile.email} data-copy-success="Email copied.">Copy email</button>
        <button type="button" data-copy-value={profile.site} data-copy-success="Homepage link copied.">Copy site link</button>
      </div>
      <p data-copy-status>Use direct email for anything sensitive or time-specific.</p>
    </div>

    <nav class="home-paths" aria-label="Start here">
      <span>Start here</span>
      {visitorPaths.map(([href, label, description]) => (
        <a href={href}>
          <strong>{label}</strong>
          <small>{description}</small>
        </a>
      ))}
    </nav>
  </section>

  <section class="profile-snapshot reveal" aria-label="Profile snapshot">
    <div class="snapshot-lead">
      <span class="eyebrow">Snapshot</span>
      <h2>Freshman at Beihang, building toward embodied intelligence.</h2>
    </div>
    <div class="snapshot-grid">
      <article>
        <span>Thread 01</span>
        <strong>Robotics instruction</strong>
        <p>Make task intent, constraints, and corrections easier for robots to interpret and execute.</p>
      </article>
      <article>
        <span>Thread 02</span>
        <strong>Sim-to-real transfer</strong>
        <p>Track the mismatch between simulation and deployment, then build toward more reliable transfer.</p>
      </article>
      <article>
        <span>Thread 03</span>
        <strong>Next robotics paradigm</strong>
        <p>Look for better diagrams for embodied intelligence after demos stop being enough.</p>
      </article>
      <article>
        <span>Current signal</span>
        <strong>{currentSignal?.data.title}</strong>
        <p>{currentSignal?.data.abstract || currentSignal?.data.summary}</p>
      </article>
      <article>
        <span>Public artifacts</span>
        <strong>{totalArtifacts}</strong>
        <p>Code, project traces, notes, maps, and other evidence links attached to public research items. Private manuscripts stay private until release.</p>
      </article>
      <article>
        <span>Latest update</span>
        <strong>{latestUpdated ? new Date(entryUpdatedValue(latestUpdated)).toISOString().slice(0, 10) : "2026"}</strong>
        <p>Content is sorted by explicit update dates so stale pages are easier to notice and revise.</p>
      </article>
    </div>
  </section>

  <ResearchRoadmap compact />

  <section class="selected-projects reveal" aria-label="Selected projects">
    <div class="section-head compact-head">
      <h2>Selected Projects</h2>
      <p>Projects are shown as research traces: what problem they touch, how they are built, and where they connect to notes or papers.</p>
    </div>
    <div class="path-grid">
      {featuredProjects.map((project) => (
        <a href={projectHref(project)}>
          <span>{project.data.status}</span>
          <strong>{project.data.title}</strong>
          <small>{project.data.summary}</small>
          {project.data.outcome && <em>{project.data.outcome}</em>}
          <EvidenceBadges artifacts={project.data.artifacts} compact />
        </a>
      ))}
    </div>
  </section>

  <section class="latest-board latest-work-stream reveal" aria-label="Latest public work">
    <div class="section-head compact-head">
      <h2>Latest Work</h2>
      <p>最近公开的 notes、research 和 projects 放在同一条工作流里，减少首页的入口堆叠。</p>
    </div>
    <div class="latest-controls" role="group" aria-label="Filter latest work">
      {latestFilters.map(([filter, label]) => (
        <button type="button" data-work-filter={filter} aria-pressed={filter === "all" ? "true" : "false"}>{label}</button>
      ))}
    </div>
    <div class="latest-stream">
      {latestWork.map((item, index) => (
        <a class="timeline-row latest-row" href={item.href} data-work-type={item.type}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <time>{new Date(item.date).toISOString().slice(0, 10)}</time>
          <strong>{item.title}</strong>
          <p>{item.description}</p>
          <em>{item.type} · {item.meta}{item.evidence ? ` · ${item.evidence} evidence signals` : ""}</em>
        </a>
      ))}
    </div>
  </section>

  <section class="timeline-preview reveal" aria-label="Recent milestones">
    <div class="section-head compact-head">
      <h2>Recent Milestones</h2>
      <p>保留最近几个公开节点，让访问者知道这个站点和研究方向正在持续推进。</p>
    </div>
    <div class="timeline-list compact-timeline">
      {latestMilestones.map((item, index) => (
        <a class="timeline-row" href={item.data.link}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <time>{item.data.date}</time>
          <strong>{item.data.title}</strong>
          <p>{item.data.summary}</p>
          <em>{item.data.type}</em>
        </a>
      ))}
    </div>
  </section>

  <SitePulse />

  <section id="contact" class="contact-section reveal">
    <div>
      <h2>Let's Talk Robotics</h2>
      <p>关于机器人指令、sim-to-real 泛化、新的机器人范式或合作，可以直接邮件联系我。</p>
    </div>
    <a class="contact-link" href={`mailto:${profile.email}`}>
      {profile.email}
      <span>→</span>
    </a>
    <a class="button-secondary" href="/contact">Contact form</a>
    <div class="contact-intents" aria-label="Contact intent shortcuts">
      {contactIntents.map(([intent, label, description]) => (
        <a href={`mailto:${profile.email}?subject=${encodeURIComponent(`[${label}] jianhenghu.com`)}&body=${encodeURIComponent(`${description}\n\n`)}`}>
          <span>{label}</span>
          <small>{description}</small>
        </a>
      ))}
    </div>
  </section>

  <section class="subscribe-section reveal">
    <div class="section-head compact-head">
      <h2>Notes Updates</h2>
      <p>如果你想偶尔收到公开笔记和研究更新，可以留下邮箱。更新不会频繁，只在确实有东西值得发出时出现。</p>
    </div>
    <SubscribeForm />
  </section>

  <script is:inline>
    const flipShell = document.querySelector(".flip-shell");
    const heroTitle = document.querySelector(".hero-title");
    const altLayer = document.querySelector(".alt-layer");
    const aboutTrigger = document.querySelector(".about-trigger");
    const backClose = document.querySelector(".back-close");
    const prefersHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const usesWaterHero = heroTitle?.classList.contains("water-hero");

    function setReveal(event) {
      if (!heroTitle || !altLayer) return;
      const rect = heroTitle.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      altLayer.style.clipPath = `circle(86px at ${x}px ${y}px)`;
    }

    function hideReveal(event) {
      if (!heroTitle || !altLayer) return;
      const rect = heroTitle.getBoundingClientRect();
      const x = event ? event.clientX - rect.left : rect.width / 2;
      const y = event ? event.clientY - rect.top : rect.height / 2;
      altLayer.style.clipPath = `circle(0 at ${x}px ${y}px)`;
    }

    // The dark hover-reveal circle is only for non-water heroes; the water hero
    // never binds it, so no black circle appears on the homepage.
    if (!usesWaterHero && prefersHover && heroTitle) {
      heroTitle.addEventListener("pointermove", setReveal);
      heroTitle.addEventListener("pointerleave", hideReveal);
    }

    aboutTrigger?.addEventListener("click", () => flipShell?.classList.add("is-flipped"));
    backClose?.addEventListener("click", () => flipShell?.classList.remove("is-flipped"));
    hideReveal();

    initHeroFx();

    // --- One pane of water, two faces (一体两面) ----------------------------
    // The hero is a single body of water shown in its two states:
    //
    //   水 — the left face is liquid: the poster is seen THROUGH the water
    //        surface. Rain falls on its own, and the pointer bends the
    //        surface into true refractive ripples (涟漪) that expand,
    //        interfere and fade on a real wave equation.
    //   雾 — the right face is vapour: layered banks of mist drift across the
    //        poster on a slow gusting wind and breathe in and out
    //        (忽隐忽现), so the butterflies ghost in and out of view. The
    //        pointer parts the mist, and it silently closes back.
    //
    //   The middle is a living blend — thin mist over calm water — where one
    //   touch raises ripples AND parts fog at the same time.
    //
    // Everything (refraction, crest light, fog banks, the parting field) is
    // composed into one offscreen ImageData and painted onto this single
    // canvas: stacking two canvases inside the hero trips an ANGLE/Metal
    // compositing bug that darkens the whole backdrop. The canvas sits UNDER
    // the CSS grade gradients (z-index 1 vs. 2), so pixels where nothing
    // happens stay fully transparent — calm water is the untouched poster.
    function initHeroFx() {
      const canvas = document.querySelector(".hero-fog");
      const source = document.querySelector(".hero-media");
      if (!heroTitle || !canvas) return;

      const ctx = canvas.getContext("2d", { alpha: true });
      const simCanvas = document.createElement("canvas");
      const simCtx = simCanvas.getContext("2d", { willReadFrequently: true });
      const srcCanvas = document.createElement("canvas");
      const srcCtx = srcCanvas.getContext("2d", { willReadFrequently: true });
      if (!ctx || !simCtx || !srcCtx) return;

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let width = 0;
      let height = 0;
      let dpr = 1;
      let gridW = 0;
      let gridH = 0;
      // Two height buffers for the ripple wave equation.
      let heightCur = null;
      let heightPrev = null;
      // Fog parting field: pointer-carved clearings that diffuse and close.
      let clearField = null;
      let clearTmp = null;
      // The two faces as per-pixel strength maps.
      let waterMask = null;
      let fogMask = null;
      // Poster pixels at grid resolution, for the refraction lookups.
      let srcData = null;
      // Heavily softened poster: the world as seen THROUGH mist. Fog doesn't
      // just whiten the poster — it silences its detail first.
      let blurData = null;
      let outputData = null;
      let lastFrame = 0;
      let ambientTimer = 1.1;
      let drizzleTimer = 0.4;
      let clock = 0; // drifts the light across the water
      let fogTime = 14; // starts mid-cycle so the first paint already has banks
      let heroVisible = true;
      // Previous pointer position (grid coords) so a fast move leaves a
      // continuous ripple trail instead of isolated drops.
      let prevGX = -1;
      let prevGY = -1;

      // -- Tileable value-noise fBm textures for the fog, generated once ------
      function makeFogTexture(seed) {
        const SIZE = 256;
        const out = new Float32Array(SIZE * SIZE);
        let state = seed >>> 0;
        const rand = () => {
          state |= 0;
          state = (state + 0x6d2b79f5) | 0;
          let t = Math.imul(state ^ (state >>> 15), 1 | state);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
        // Wrapped lattices keep every octave seamless when the texture scrolls.
        const octaves = [
          [6, 0.52],
          [12, 0.26],
          [24, 0.14],
          [48, 0.08],
        ];
        for (const [period, weight] of octaves) {
          const lattice = new Float32Array(period * period);
          for (let i = 0; i < lattice.length; i += 1) lattice[i] = rand();
          for (let y = 0; y < SIZE; y += 1) {
            const fy = (y / SIZE) * period;
            const y0 = Math.floor(fy) % period;
            const y1 = (y0 + 1) % period;
            let ty = fy - Math.floor(fy);
            ty = ty * ty * (3 - 2 * ty);
            for (let x = 0; x < SIZE; x += 1) {
              const fx = (x / SIZE) * period;
              const x0 = Math.floor(fx) % period;
              const x1 = (x0 + 1) % period;
              let tx = fx - Math.floor(fx);
              tx = tx * tx * (3 - 2 * tx);
              const a = lattice[y0 * period + x0];
              const b = lattice[y0 * period + x1];
              const c = lattice[y1 * period + x0];
              const d = lattice[y1 * period + x1];
              out[y * SIZE + x] += weight * ((a + (b - a) * tx) * (1 - ty) + (c + (d - c) * tx) * ty);
            }
          }
        }
        return out;
      }

      const fogTexA = makeFogTexture(20260617); // large slow banks
      const fogTexB = makeFogTexture(90417); // finer counter-drifting detail

      function sampleFog(tex, u, v) {
        const fu = u - Math.floor(u);
        const fv = v - Math.floor(v);
        const fx = fu * 256;
        const fy = fv * 256;
        const x0 = Math.floor(fx) & 255;
        const y0 = Math.floor(fy) & 255;
        const x1 = (x0 + 1) & 255;
        const y1 = (y0 + 1) & 255;
        const tx = fx - Math.floor(fx);
        const ty = fy - Math.floor(fy);
        const a = tex[y0 * 256 + x0];
        const b = tex[y0 * 256 + x1];
        const c = tex[y1 * 256 + x0];
        const d = tex[y1 * 256 + x1];
        return (a + (b - a) * tx) * (1 - ty) + (c + (d - c) * tx) * ty;
      }

      function smooth01(edge0, edge1, x) {
        const t = Math.min(1, Math.max(0, (x - edge0) / (edge1 - edge0)));
        return t * t * (3 - 2 * t);
      }

      // Three separable box passes ≈ a wide gaussian — the poster as it looks
      // through real mist, with all its busy streaks dissolved.
      function buildMistPixels(pixels) {
        const n = gridW * gridH;
        let cur = new Float32Array(n * 3);
        let tmp = new Float32Array(n * 3);
        for (let i = 0; i < n; i += 1) {
          cur[i * 3] = pixels[i * 4];
          cur[i * 3 + 1] = pixels[i * 4 + 1];
          cur[i * 3 + 2] = pixels[i * 4 + 2];
        }
        const radius = Math.max(4, Math.round(gridW / 52));
        const win = radius * 2 + 1;
        for (let pass = 0; pass < 3; pass += 1) {
          for (let y = 0; y < gridH; y += 1) {
            const row = y * gridW;
            let sr = 0;
            let sg = 0;
            let sb = 0;
            for (let x = -radius; x <= radius; x += 1) {
              const cx = x < 0 ? 0 : x > gridW - 1 ? gridW - 1 : x;
              const j = (row + cx) * 3;
              sr += cur[j];
              sg += cur[j + 1];
              sb += cur[j + 2];
            }
            for (let x = 0; x < gridW; x += 1) {
              const j = (row + x) * 3;
              tmp[j] = sr / win;
              tmp[j + 1] = sg / win;
              tmp[j + 2] = sb / win;
              const xa = x - radius < 0 ? 0 : x - radius;
              const xr = x + radius + 1 > gridW - 1 ? gridW - 1 : x + radius + 1;
              const ja = (row + xa) * 3;
              const jr = (row + xr) * 3;
              sr += cur[jr] - cur[ja];
              sg += cur[jr + 1] - cur[ja + 1];
              sb += cur[jr + 2] - cur[ja + 2];
            }
          }
          for (let x = 0; x < gridW; x += 1) {
            let sr = 0;
            let sg = 0;
            let sb = 0;
            for (let y = -radius; y <= radius; y += 1) {
              const cy = y < 0 ? 0 : y > gridH - 1 ? gridH - 1 : y;
              const j = (cy * gridW + x) * 3;
              sr += tmp[j];
              sg += tmp[j + 1];
              sb += tmp[j + 2];
            }
            for (let y = 0; y < gridH; y += 1) {
              const j = (y * gridW + x) * 3;
              cur[j] = sr / win;
              cur[j + 1] = sg / win;
              cur[j + 2] = sb / win;
              const ya = y - radius < 0 ? 0 : y - radius;
              const yr = y + radius + 1 > gridH - 1 ? gridH - 1 : y + radius + 1;
              const ja = (ya * gridW + x) * 3;
              const jr = (yr * gridW + x) * 3;
              sr += tmp[jr] - tmp[ja];
              sg += tmp[jr + 1] - tmp[ja + 1];
              sb += tmp[jr + 2] - tmp[ja + 2];
            }
          }
        }
        return cur;
      }

      function rebuild() {
        const rect = heroTitle.getBoundingClientRect();
        width = Math.max(1, Math.round(rect.width));
        height = Math.max(1, Math.round(rect.height));
        dpr = Math.min(2, window.devicePixelRatio || 1);
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        // Grid ≈ 1/3.6 of CSS pixels: fine enough for rings, coarse enough
        // that the fog reads as soft banks once upscaled.
        gridW = Math.min(400, Math.max(180, Math.round(width / 3.6)));
        gridH = Math.max(100, Math.round((gridW * height) / width));
        const gridN = gridW * gridH;
        simCanvas.width = gridW;
        simCanvas.height = gridH;
        heightCur = new Float32Array(gridN);
        heightPrev = new Float32Array(gridN);
        clearField = new Float32Array(gridN);
        clearTmp = new Float32Array(gridN);
        outputData = simCtx.createImageData(gridW, gridH);

        // The face map: liquid on the left, vapour on the right, a wide
        // breathing blend between them. Mist also gathers low over the water
        // and pools in the top-right corner. On narrow (portrait) panes the
        // side-by-side split has no room to breathe, so the mist withdraws
        // to the far right edge and the lower bank instead.
        const narrow = width < 700;
        waterMask = new Float32Array(gridN);
        fogMask = new Float32Array(gridN);
        for (let y = 0; y < gridH; y += 1) {
          const ny = y / gridH;
          for (let x = 0; x < gridW; x += 1) {
            const nx = x / gridW;
            const i = y * gridW + x;
            waterMask[i] = narrow ? 1 - smooth01(0.3, 0.9, nx) : 1 - smooth01(0.24, 0.68, nx);
            const side = narrow ? smooth01(0.52, 0.98, nx) : smooth01(0.26, 0.72, nx);
            const low = narrow
              ? 0.3 + 0.7 * smooth01(0.28, 0.98, ny)
              : 0.62 + 0.38 * smooth01(0.02, 0.85, ny);
            const cornerDx = (nx - 0.88) / 0.22;
            const cornerDy = (ny - 0.16) / 0.3;
            const corner = Math.exp(-(cornerDx * cornerDx + cornerDy * cornerDy));
            fogMask[i] = Math.min(1, side * low + (narrow ? 0.3 : 0.65) * corner) * (narrow ? 0.72 : 1);
          }
        }

        // Poster pixels at grid res, cropped exactly like object-fit: cover at
        // object-position: center 46%, so at rest the refraction is identical
        // to the untouched poster and quietly disappears.
        srcData = null;
        if (source && source.complete && source.naturalWidth) {
          const iw = source.naturalWidth;
          const ih = source.naturalHeight;
          const scale = Math.max(gridW / iw, gridH / ih);
          const dw = iw * scale;
          const dh = ih * scale;
          srcCanvas.width = gridW;
          srcCanvas.height = gridH;
          srcCtx.clearRect(0, 0, gridW, gridH);
          srcCtx.drawImage(source, (gridW - dw) / 2, (gridH - dh) * 0.46, dw, dh);
          srcData = srcCtx.getImageData(0, 0, gridW, gridH).data;
          blurData = buildMistPixels(srcData);
        }
        prevGX = -1;
        prevGY = -1;
        render();
      }

      // -- 水: the wave field -------------------------------------------------
      // A soft drop; the wave equation spreads it into expanding rings.
      function dropAt(gx, gy, amp, radius) {
        if (!heightPrev) return;
        const r = Math.max(1, Math.ceil(radius));
        const rsq = radius * radius;
        const cx = Math.round(gx);
        const cy = Math.round(gy);
        for (let dy = -r; dy <= r; dy += 1) {
          const py = cy + dy;
          if (py < 1 || py >= gridH - 1) continue;
          for (let dx = -r; dx <= r; dx += 1) {
            const px = cx + dx;
            if (px < 1 || px >= gridW - 1) continue;
            const d2 = dx * dx + dy * dy;
            if (d2 > rsq) continue;
            heightPrev[py * gridW + px] += amp * Math.cos((Math.sqrt(d2) / radius) * Math.PI * 0.5);
          }
        }
      }

      // Every cell relaxes toward its neighbours while energy slowly bleeds
      // away, so a touch expands and fades the way still water does.
      function stepWater() {
        if (!heightCur || !heightPrev) return;
        const damping = 0.991;
        for (let y = 1; y < gridH - 1; y += 1) {
          let i = y * gridW + 1;
          for (let x = 1; x < gridW - 1; x += 1, i += 1) {
            heightPrev[i] = (
              (heightCur[i - 1] + heightCur[i + 1] + heightCur[i - gridW] + heightCur[i + gridW]) * 0.5 -
              heightPrev[i]
            ) * damping;
          }
        }
        const swap = heightCur;
        heightCur = heightPrev;
        heightPrev = swap;
      }

      // Rain on the liquid face, on two channels: a steady drizzle of tiny
      // drops whose overlapping rings keep the surface shimmering even at
      // rest, and the occasional heavier drop or slow broad swell.
      function seedAmbient(dt) {
        if (!gridW) return;
        ambientTimer -= dt;
        drizzleTimer -= dt;
        if (drizzleTimer <= 0) {
          drizzleTimer = 0.14 + Math.random() * 0.3;
          dropAt(
            (0.05 + Math.random() * 0.52) * gridW,
            (0.08 + Math.random() * 0.84) * gridH,
            0.5 + Math.random() * 0.4,
            2.6 + Math.random() * 1.6,
          );
        }
        if (ambientTimer > 0) return;
        ambientTimer = 1.6 + Math.random() * 2.2;
        const gx = (0.05 + Math.random() * 0.52) * gridW;
        const gy = (0.08 + Math.random() * 0.84) * gridH;
        if (Math.random() < 0.2) {
          dropAt(gx, gy, 0.6 + Math.random() * 0.25, 7 + Math.random() * 4);
        } else {
          dropAt(gx, gy, 0.85 + Math.random() * 0.3, 3.5 + Math.random() * 1.8);
        }
      }

      // -- 雾: the parting field ----------------------------------------------
      // Carved clearings decay back and bleed outward a little, so parted fog
      // closes in softly instead of popping back. The pass is skipped entirely
      // while the field is clear, which is most of the time.
      let clearActive = false;

      function stepFogField(dt) {
        if (!clearField || !clearActive) return;
        const decay = Math.exp(-dt / 6.5);
        let peak = 0;
        for (let y = 0; y < gridH; y += 1) {
          for (let x = 0; x < gridW; x += 1) {
            const i = y * gridW + x;
            const l = clearField[x > 0 ? i - 1 : i];
            const r = clearField[x < gridW - 1 ? i + 1 : i];
            const u = clearField[y > 0 ? i - gridW : i];
            const b = clearField[y < gridH - 1 ? i + gridW : i];
            clearTmp[i] = clearField[i] * decay + ((l + r + u + b) * 0.25 - clearField[i]) * 0.22;
            if (clearTmp[i] > peak) peak = clearTmp[i];
          }
        }
        const swap = clearField;
        clearField = clearTmp;
        clearTmp = swap;
        if (peak < 0.004) {
          clearField.fill(0);
          clearActive = false;
        }
      }

      function partFogAt(nx, ny, radiusN, strength) {
        if (!clearField || !gridW) return;
        clearActive = true;
        const gx = nx * gridW;
        const gy = ny * gridH;
        const r = Math.max(2, radiusN * gridW);
        const rsq = r * r;
        const x0 = Math.max(0, Math.floor(gx - r));
        const x1 = Math.min(gridW - 1, Math.ceil(gx + r));
        const y0 = Math.max(0, Math.floor(gy - r));
        const y1 = Math.min(gridH - 1, Math.ceil(gy + r));
        for (let y = y0; y <= y1; y += 1) {
          for (let x = x0; x <= x1; x += 1) {
            const dx = x - gx;
            const dy = y - gy;
            const d2 = dx * dx + dy * dy;
            if (d2 > rsq) continue;
            // smoothstep shoulder: the clearing melts into the surrounding
            // mist with no visible edge
            const t = Math.sqrt(d2) / r;
            const fall = 1 - t * t * (3 - 2 * t);
            const i = y * gridW + x;
            const v = clearField[i] + strength * fall;
            clearField[i] = v > 1 ? 1 : v;
          }
        }
      }

      // -- compose both faces into one ImageData ------------------------------
      function compose() {
        if (!outputData || !heightCur || !waterMask) return;
        const d = outputData.data;
        // The light drifts slowly, so crests shimmer instead of sitting still.
        const lx = 0.42 + 0.18 * Math.sin(clock * 0.21);
        const ly = 0.86 + 0.1 * Math.cos(clock * 0.16);
        // The mist breathes and the wind gusts on slow incommensurate periods,
        // so the banks thicken and thin without ever repeating.
        const breath = 0.58 + 0.42 * (0.62 * Math.sin(fogTime * 0.32) + 0.38 * Math.sin(fogTime * 0.115 + 1.7));
        const gust = 1 + 0.7 * Math.sin(fogTime * 0.14 + 0.8) + 0.35 * Math.sin(fogTime * 0.041);
        const driftU1 = fogTime * 0.0075 * gust;
        const driftV1 = fogTime * 0.0018;
        const driftU2 = -fogTime * 0.017 * gust;
        const driftV2 = fogTime * 0.004;
        // Banks are stretched horizontally — mist lies in layers.
        const su1 = 1.9 / gridW;
        const sv1 = (3.4 * (height / width)) / gridH;
        const su2 = 4.6 / gridW;
        const sv2 = (7.4 * (height / width)) / gridH;
        const REFRACT = 5.0;
        for (let y = 0; y < gridH; y += 1) {
          const fogV1 = y * sv1 + driftV1;
          const fogV2 = y * sv2 + driftV2;
          for (let x = 0; x < gridW; x += 1) {
            const i = y * gridW + x;
            const di = i * 4;
            const wa = waterMask[i];

            // liquid: a displaced poster sample plus drifting crest light
            let lr = 0;
            let lg = 0;
            let lb = 0;
            let la = 0;
            if (wa > 0.001 && srcData) {
              const gx = heightCur[x > 0 ? i - 1 : i] - heightCur[x < gridW - 1 ? i + 1 : i];
              const gy = heightCur[y > 0 ? i - gridW : i] - heightCur[y < gridH - 1 ? i + gridW : i];
              const slope = Math.abs(gx) + Math.abs(gy);
              // Calm water is invisible — the untouched poster shows through.
              if (slope > 0.018) {
                let ox = gx * REFRACT;
                let oy = gy * REFRACT;
                if (ox > 6) ox = 6;
                else if (ox < -6) ox = -6;
                if (oy > 6) oy = 6;
                else if (oy < -6) oy = -6;
                let sx = x + Math.round(ox);
                let sy = y + Math.round(oy);
                if (sx < 0) sx = 0;
                else if (sx >= gridW) sx = gridW - 1;
                if (sy < 0) sy = 0;
                else if (sy >= gridH) sy = gridH - 1;
                const si = (sy * gridW + sx) * 4;
                lr = srcData[si];
                lg = srcData[si + 1];
                lb = srcData[si + 2];
                // Water takes colour out of what it refracts — a touch of
                // deep teal in the displaced poster.
                lr = lr * 0.94;
                lb = lb * 1.03 + 2;
                // The rising face catches the light, the falling face cools.
                // tanh keeps fresh impacts bright without blowing out, while
                // giving faint old rings enough edge light to stay visible.
                const spec = gx * lx + gy * ly;
                const s = Math.tanh(spec * 1.9);
                if (s > 0) {
                  lr += s * 44;
                  lg += s * 58;
                  lb += s * 80;
                } else {
                  lr += s * 21;
                  lg += s * 27;
                  lb += s * 38;
                }
                const lens = slope * 3.6;
                la = wa * (lens > 0.95 ? 0.95 : lens);
              }
            }

            // vapour: two counter-drifting fBm banks, breathing, parted.
            // Dense banks don't tint the poster — they REPLACE its busy
            // detail with the silenced, milky world-behind-mist.
            let fa = 0;
            const fm = fogMask[i];
            if (fm > 0.004) {
              const n1 = sampleFog(fogTexA, x * su1 + driftU1, fogV1);
              const n2 = sampleFog(fogTexB, x * su2 + driftU2, fogV2);
              const density = smooth01(0.26, 0.86, n1 * 0.62 + n2 * 0.38);
              const cl = clearField[i];
              fa = density * fm * breath * (1 - cl) * 0.95;
              if (fa > 0.003) {
                let fr = 238;
                let fg = 246;
                let fb = 253;
                if (blurData) {
                  const milk = 0.4 + 0.55 * density;
                  const mi = i * 3;
                  fr = blurData[mi] * (1 - milk) + 238 * milk;
                  fg = blurData[mi + 1] * (1 - milk) + 246 * milk;
                  fb = blurData[mi + 2] * (1 - milk) + 253 * milk;
                }
                // A wiped swipe gathers a fine bead of water along its edge,
                // which catches the light before the mist closes back over it.
                const cg =
                  Math.abs(clearField[x > 0 ? i - 1 : i] - clearField[x < gridW - 1 ? i + 1 : i]) +
                  Math.abs(clearField[y > 0 ? i - gridW : i] - clearField[y < gridH - 1 ? i + gridW : i]);
                const rim = Math.min(1, cg * 4) * (cl * (1 - cl)) * 4;
                if (rim > 0.01) {
                  fr += rim * 38;
                  fg += rim * 44;
                  fb += rim * 50;
                }
                // fog over water over (transparent → the untouched poster)
                const outA = fa + la * (1 - fa);
                const lw = (la * (1 - fa)) / outA;
                d[di] = lr * lw + fr * (1 - lw);
                d[di + 1] = lg * lw + fg * (1 - lw);
                d[di + 2] = lb * lw + fb * (1 - lw);
                d[di + 3] = outA * 255;
                continue;
              }
            }
            if (la <= 0.003) {
              d[di + 3] = 0;
              continue;
            }
            d[di] = lr;
            d[di + 1] = lg;
            d[di + 2] = lb;
            d[di + 3] = la * 255;
          }
        }
      }

      function render() {
        if (!width || !height) return;
        compose();
        if (!outputData) return;
        simCtx.putImageData(outputData, 0, 0);
        ctx.clearRect(0, 0, width, height);
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = "high";
        ctx.save();
        // A whisper of blur dissolves the grid so rings and banks read as
        // continuous water and mist, never as pixels.
        ctx.filter = "blur(0.6px)";
        ctx.drawImage(simCanvas, 0, 0, width, height);
        ctx.restore();
      }

      // One touch, two answers — but each face answers the way it really would:
      //   tap  = a raindrop: one ring that rings out on its own;
      //   drag = a finger through water: it pushes a continuous FURROW into
      //          the surface (negative height along the path), and the wave
      //          equation radiates that trench outward as a wake that trails
      //          and closes behind the pointer. Not a string of circles.
      function furrowAlong(x0, y0, x1, y1, amp, radius) {
        const dist = Math.hypot(x1 - x0, y1 - y0);
        const steps = Math.max(1, Math.ceil(dist / (radius * 0.55)));
        for (let s = 0; s <= steps; s += 1) {
          const t = s / steps;
          dropAt(x0 + (x1 - x0) * t, y0 + (y1 - y0) * t, -amp, radius);
        }
      }

      function disturbFromPointer(event, strong = false) {
        if (!gridW) return;
        const rect = heroTitle.getBoundingClientRect();
        const nx = (event.clientX - rect.left) / rect.width;
        const ny = (event.clientY - rect.top) / rect.height;
        const gx = nx * gridW;
        const gy = ny * gridH;
        if (strong || prevGX < 0) {
          // first contact: a fingertip touching the surface — one soft dimple
          dropAt(gx, gy, strong ? 0.8 : 0.5, strong ? 2.8 : 2.3);
        } else {
          const dx = gx - prevGX;
          const dy = gy - prevGY;
          const dist = Math.hypot(dx, dy);
          if (dist >= 0.6) {
            const amp = Math.min(0.4, Math.max(0.09, dist * 0.028));
            furrowAlong(prevGX, prevGY, gx, gy, amp, 2.3);
          }
        }
        prevGX = gx;
        prevGY = gy;
        partFogAt(nx, ny, 0.095, strong ? 0.55 : 0.38);
        if (reducedMotion) render();
      }

      function animate(time) {
        requestAnimationFrame(animate);
        const raw = lastFrame ? Math.min(0.05, (time - lastFrame) / 1000) : 0.016;
        lastFrame = time;
        if (document.hidden || !heroVisible) return;
        clock += raw;
        fogTime += raw;
        seedAmbient(raw);
        stepWater();
        stepFogField(raw);
        render();
      }

      heroTitle.addEventListener("pointerenter", (event) => disturbFromPointer(event, true));
      heroTitle.addEventListener("pointermove", (event) => disturbFromPointer(event));
      heroTitle.addEventListener("pointerleave", () => {
        prevGX = -1;
        prevGY = -1;
      });

      if (window.IntersectionObserver) {
        new IntersectionObserver(([entry]) => {
          heroVisible = entry.isIntersecting;
        }).observe(heroTitle);
      }
      if (window.ResizeObserver) new ResizeObserver(rebuild).observe(heroTitle);
      window.addEventListener("resize", rebuild);
      if (source && source.complete && source.naturalWidth) rebuild();
      else if (source) source.addEventListener("load", rebuild, { once: true });
      else rebuild();
      if (!reducedMotion) requestAnimationFrame(animate);
    }

    document.querySelectorAll("[data-copy-value]").forEach((button) => {
      const status = button.closest(".home-contact-tool")?.querySelector("[data-copy-status]");
      const originalText = button.textContent;
      const originalStatus = status?.textContent || "";
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copyValue || "");
          button.textContent = "Copied";
          if (status) status.textContent = button.dataset.copySuccess || "Copied to clipboard.";
        } catch {
          button.textContent = "Copy failed";
          if (status) status.textContent = "Copy is unavailable in this browser.";
        }
        window.setTimeout(() => {
          button.textContent = originalText;
          if (status) status.textContent = originalStatus;
        }, 1800);
      });
    });

    const latestButtons = [...document.querySelectorAll("[data-work-filter]")];
    const latestRows = [...document.querySelectorAll("[data-work-type]")];
    latestButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.workFilter || "all";
        latestButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        latestRows.forEach((row) => {
          row.hidden = filter !== "all" && row.dataset.workType !== filter;
        });
      });
    });
  </script>
</BaseLayout>
