---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout current="Search" title="Search | HJH" description="Search notes, papers, projects, library items, timeline entries, and pages on Jianheng Hu's personal site.">
  <section class="content-hero">
    <span class="eyebrow">Search</span>
    <h1>Find notes, papers, projects, and pages</h1>
    <p>Fuzzy local search over generated site content. Use filters to narrow by content type, status, or tag.</p>
  </section>

  <section class="notes-tools search-tools">
    <label for="global-search">Search site</label>
    <input id="global-search" type="search" placeholder="Try sim-to-real, CCHIHH, robotics, Obsidian..." data-global-search autofocus />
    <div class="filter-row" data-type-filters>
      {["all", "note", "paper", "project", "library", "timeline", "page"].map((type) => (
        <button type="button" data-filter={type} aria-pressed={type === "all" ? "true" : "false"}>{type}</button>
      ))}
    </div>
    <div class="tool-links" data-dynamic-filters></div>
    <p class="muted" data-search-count>Loading search index...</p>
  </section>

  <section class="notes-list" data-search-results>
    <p class="muted">Start typing to search generated content.</p>
  </section>

  <script is:inline>
    const input = document.querySelector("[data-global-search]");
    const results = document.querySelector("[data-search-results]");
    const filterButtons = [...document.querySelectorAll("[data-type-filters] button")];
    const dynamicFilters = document.querySelector("[data-dynamic-filters]");
    const count = document.querySelector("[data-search-count]");
    const params = new URLSearchParams(window.location.search);
    let index = [];
    let activeType = params.get("type") || "all";
    let activeMeta = params.get("tag") || "";
    if (!filterButtons.some((button) => button.dataset.filter === activeType)) activeType = "all";

    if (input && params.get("q")) input.value = params.get("q");
    filterButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.filter === activeType)));

    fetch("/search.json")
      .then((response) => response.json())
      .then((items) => {
        index = items.map((item) => ({
          ...item,
          haystack: `${item.title} ${item.description} ${item.content || ""} ${(item.tags || []).join(" ")} ${item.type} ${item.status || ""} ${item.date || ""}`.toLowerCase(),
        })).sort((a, b) => dateRank(b.date) - dateRank(a.date));
        renderDynamicFilters();
        render();
      })
      .catch(() => {
        results.innerHTML = '<p class="muted">Search index is not available right now.</p>';
      });

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeType = button.dataset.filter || "all";
        filterButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        render();
      });
    });

    input?.addEventListener("input", render);

    function renderDynamicFilters() {
      if (!dynamicFilters) return;
      const values = [...new Set(index.flatMap((item) => [...(item.tags || []), item.status].filter(Boolean)))].slice(0, 18);
      dynamicFilters.innerHTML = values.map((value) => `<button type="button" data-meta="${escapeHtml(value)}">${escapeHtml(value)}</button>`).join("");
      dynamicFilters.querySelectorAll("button").forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.meta === activeMeta));
        button.addEventListener("click", () => {
          activeMeta = activeMeta === button.dataset.meta ? "" : button.dataset.meta || "";
          dynamicFilters.querySelectorAll("button").forEach((item) => item.setAttribute("aria-pressed", String(item.dataset.meta === activeMeta)));
          render();
        });
      });
    }

    function render() {
      const query = input?.value.trim().toLowerCase() || "";
      syncUrl(query);
      const pool = index.filter((item) =>
        (activeType === "all" || item.type === activeType) &&
        (!activeMeta || item.status === activeMeta || (item.tags || []).includes(activeMeta))
      );
      const matches = (query ? pool.map((item) => ({ item, score: fuzzyScore(item.haystack, query) })).filter((row) => row.score > 0).sort((a, b) => b.score - a.score).map((row) => row.item) : pool).slice(0, 18);
      if (count) count.textContent = `${matches.length} result${matches.length === 1 ? "" : "s"} shown from ${pool.length} candidate${pool.length === 1 ? "" : "s"}.`;

      results.innerHTML = matches.length
        ? matches.map((item) => `
          <a class="note-row" href="${item.url}">
            <span>${escapeHtml(item.type)} · ${escapeHtml(item.status || item.date || "")}</span>
            <strong>${highlight(item.title, query)}</strong>
            <p>${highlight(snippet(item, query), query)}</p>
            <em>${escapeHtml([
              item.date,
              ...(item.evidenceTypes || []),
              ...(item.tags || []).slice(0, 5),
            ].filter(Boolean).join(" · "))}</em>
          </a>
        `).join("")
        : `<div class="search-empty"><p class="muted">No results yet. Try a broader term, remove filters, or open a recommended entry.</p><a href="/research/map">Research Map</a><a href="/library/sim-to-real-transfer">Sim-to-real Library</a><a href="/projects/personal-homepage">Homepage Project</a></div>`;
    }

    function fuzzyScore(text, query) {
      if (!query) return 1;
      if (text.includes(query)) return 100 + query.length;
      let score = 0;
      let cursor = 0;
      for (const char of query) {
        const found = text.indexOf(char, cursor);
        if (found === -1) return 0;
        score += Math.max(1, 12 - (found - cursor));
        cursor = found + 1;
      }
      return score;
    }

    function escapeHtml(value) {
      return String(value || "").replace(/[&<>"']/g, (char) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;",
      }[char]));
    }

    function highlight(value, query) {
      const text = escapeHtml(value);
      const needle = String(query || "").trim();
      if (!needle) return text;
      const escaped = needle.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      return text.replace(new RegExp(`(${escaped})`, "ig"), "<mark>$1</mark>");
    }

    function snippet(item, query) {
      const content = String(item.content || item.description || "");
      const needle = String(query || "").toLowerCase();
      if (!needle) return item.description || content.slice(0, 180);
      const index = content.toLowerCase().indexOf(needle);
      if (index < 0) return item.description || content.slice(0, 180);
      const start = Math.max(0, index - 70);
      const end = Math.min(content.length, index + needle.length + 110);
      return `${start > 0 ? "..." : ""}${content.slice(start, end)}${end < content.length ? "..." : ""}`;
    }

    function dateRank(value) {
      const text = String(value || "");
      const normalized = text.length === 4 ? `${text}-01-01` : text.length === 7 ? `${text}-01` : text;
      const number = Date.parse(normalized);
      return Number.isFinite(number) ? number : 0;
    }

    function syncUrl(query) {
      const next = new URLSearchParams();
      if (query) next.set("q", query);
      if (activeType !== "all") next.set("type", activeType);
      if (activeMeta) next.set("tag", activeMeta);
      const target = next.toString() ? `${location.pathname}?${next}` : location.pathname;
      history.replaceState(null, "", target);
    }
  </script>
</BaseLayout>
