---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EvidencePanel from "../../components/EvidencePanel.astro";
import FeedbackForm from "../../components/FeedbackForm.astro";
import { projectHref, projectSlug } from "../../utils/content";
import { mergeArtifacts } from "../../utils/artifacts";
import { collectRelationGroups } from "../../utils/relations";
import { profile } from "../../data/profile";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter((project) => !project.data.draft);
  return projects.map((project) => ({ params: { slug: projectSlug(project) }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const [allPapers, allProjects, allNotes, allLibrary] = await Promise.all([
  getCollection("papers", (item) => !item.data.draft),
  getCollection("projects", (item) => !item.data.draft),
  getCollection("notes", (item) => !item.data.draft),
  getCollection("library", (item) => !item.data.draft),
]);
const relationGroups = collectRelationGroups(projectHref(project), [
  ...project.data.relatedPapers,
  ...project.data.relatedNotes,
  ...project.data.relatedLibrary,
  ...project.data.artifacts.map((artifact) => artifact.href),
  ...project.data.links.map((link) => link.href),
], project.data.tags, {
  papers: allPapers,
  projects: allProjects,
  notes: allNotes,
  library: allLibrary,
});
const projectArtifacts = mergeArtifacts([
  ...project.data.artifacts,
  project.data.url && {
    label: "Primary link",
    type: "code",
    href: project.data.url,
    description: "Primary public link for this project.",
    status: "available",
  },
  ...project.data.links.map((link) => ({
    label: link.label,
    type: "link",
    href: link.href,
    description: "Curated project reference.",
    status: "available",
  })),
  ...project.data.relatedPapers.map((href) => ({
    label: "Related research",
    type: "paper",
    href,
    description: "Research entry connected to this project.",
    status: "available",
  })),
  ...project.data.relatedNotes.map((href) => ({
    label: "Related note",
    type: "note",
    href,
    description: "Public note connected to this project.",
    status: "available",
  })),
]);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": project.data.repo ? "SoftwareSourceCode" : "CreativeWork",
  name: project.data.title,
  description: project.data.summary,
  url: new URL(projectHref(project), profile.site).toString(),
  codeRepository: project.data.url,
  programmingLanguage: project.data.techStack,
  keywords: project.data.tags,
  about: project.data.thread,
};
---

<BaseLayout
  current="Projects"
  title={`${project.data.title} | HJH Projects`}
  description={project.data.summary}
  jsonLd={jsonLd}
  ogType="article"
>
  <article class="article-page project-detail">
    <header class="article-header">
      <a href="/projects">← Projects</a>
      <time>{project.data.status} · {project.data.statusDetail}</time>
      <h1>{project.data.title}</h1>
      <p>{project.data.summary}</p>
      <div class="tag-row">{project.data.tags.map((tag) => <span>{tag}</span>)}</div>
      <div class="paper-meta">
        {project.data.thread && <span>{project.data.thread}</span>}
        <span>{projectArtifacts.length} artifacts</span>
        {project.data.updatedDate && <span>updated {project.data.updatedDate.toISOString().slice(0, 10)}</span>}
      </div>
      <div class="paper-actions">
        {project.data.url && <a href={project.data.url} target="_blank" rel="noopener noreferrer">GitHub</a>}
        {project.data.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </header>

    <div class="detail-grid">
      <section>
        <span class="panel-kicker">Problem</span>
        <p>{project.data.problem}</p>
      </section>
      <section>
        <span class="panel-kicker">Method</span>
        <p>{project.data.method}</p>
      </section>
      {project.data.evidence.length > 0 && (
        <section>
          <span class="panel-kicker">Evidence</span>
          <ul>{project.data.evidence.map((item) => <li>{item}</li>)}</ul>
        </section>
      )}
      {project.data.outcome && (
        <section>
          <span class="panel-kicker">Outcome</span>
          <p>{project.data.outcome}</p>
        </section>
      )}
      {project.data.lessons.length > 0 && (
        <section>
          <span class="panel-kicker">Lessons Learned</span>
          <ul>{project.data.lessons.map((item) => <li>{item}</li>)}</ul>
        </section>
      )}
      {project.data.maturityNote && (
        <section>
          <span class="panel-kicker">Maturity</span>
          <p>{project.data.maturityNote}</p>
        </section>
      )}
      {project.data.techStack.length > 0 && (
        <section>
          <span class="panel-kicker">Used Technologies</span>
          <p>{project.data.techStack.join(" / ")}</p>
        </section>
      )}
      {project.data.nextStep && (
        <section>
          <span class="panel-kicker">Next Checkpoint</span>
          <p>{project.data.nextStep}</p>
        </section>
      )}
    </div>

    <EvidencePanel artifacts={projectArtifacts} />

    <div class="article-body">
      <Content />
      <section class="related-block relation-groups">
        <h2>Related Graph</h2>
        <div class="relation-group-grid">
          <div>
            <h3>Upstream</h3>
            <p>Research, notes, and artifacts this project points to.</p>
            <div class="inline-links">{relationGroups.upstream.map((link) => <a href={link.href}>{link.type}: {link.title}</a>)}</div>
          </div>
          <div>
            <h3>Downstream</h3>
            <p>Pages that link back to this project.</p>
            <div class="inline-links">{relationGroups.downstream.map((link) => <a href={link.href}>{link.type}: {link.title}</a>)}</div>
          </div>
          <div>
            <h3>Sibling</h3>
            <p>Nearby work with shared tags.</p>
            <div class="inline-links">{relationGroups.siblings.map((link) => <a href={link.href}>{link.type}: {link.title}</a>)}</div>
          </div>
        </div>
      </section>
      <FeedbackForm targetType="project" targetTitle={project.data.title} targetUrl={projectHref(project)} />
    </div>
  </article>
</BaseLayout>
