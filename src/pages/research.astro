---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchRoadmap from "../components/ResearchRoadmap.astro";
import EvidenceBadges from "../components/EvidenceBadges.astro";
import { paperHref } from "../utils/content";

const papers = (await getCollection("papers"))
  .filter((paper) => !paper.data.draft)
  .sort((a, b) => b.data.year - a.data.year);
const projects = (await getCollection("projects")).filter((project) => !project.data.draft && project.data.featured);
const library = (await getCollection("library")).filter((item) => !item.data.draft && item.data.featured).slice(0, 3);
---

<BaseLayout
  current="Research"
  title="Research | HJH"
  description="Research progress by Jianheng Hu: robotics instruction, sim-to-real generalization, cloud-edge-device scheduling, and the next robotics paradigm."
>
  <section class="content-hero">
    <span class="eyebrow">Research</span>
    <h1>Papers, questions, and research progress</h1>
    <p>Public-facing research threads, paper status, released artifacts, code links, and notes that make the direction easier to inspect.</p>
    <div class="hero-actions">
      <a class="button-primary" href="#papers">Papers</a>
      <a class="button-secondary" href="/research/map">Research map</a>
      <a class="button-secondary" href="/projects">Projects</a>
      <a class="button-secondary" href="/library">Library</a>
    </div>
  </section>

  <ResearchRoadmap />

  <section class="research-snapshot reveal" aria-label="Research snapshot">
    <div class="section-head compact-head">
      <h2>Research Snapshot</h2>
      <p>The public record is organized around questions, artifacts, and evidence rather than a long list of claims.</p>
    </div>
    <div class="snapshot-grid">
      <article>
        <span>Papers</span>
        <strong>{papers.length}</strong>
        <p>Public paper entries with status, abstract, PDF/code links, BibTeX, and related notes.</p>
      </article>
      <article>
        <span>Projects</span>
        <strong>{projects.length}</strong>
        <p>Selected implementation traces connected to research or tooling directions.</p>
      </article>
      <article>
        <span>Library</span>
        <strong>{library.length}</strong>
        <p>Reading and resource entries that shape the current research route.</p>
      </article>
      <article>
        <span>Principle</span>
        <strong>Evidence first</strong>
        <p>Each research item should make its problem, method, next step, and artifacts inspectable. The map view connects those pieces.</p>
      </article>
    </div>
  </section>

  <section id="papers" class="paper-list">
    {papers.map((paper, index) => (
      <article class="paper-item">
        <div class="paper-index">{String(index + 1).padStart(2, "0")}</div>
        <div>
          <div class="paper-meta">
            <span>{paper.data.status}</span>
            <span>{paper.data.year}</span>
            {paper.data.venue && <span>{paper.data.venue}</span>}
            {paper.data.thread && <span>{paper.data.thread}</span>}
            {paper.data.artifacts.length > 0 && <span>{paper.data.artifacts.length} artifacts</span>}
          </div>
          <h2><a href={paperHref(paper)}>{paper.data.title}</a></h2>
          <p class="paper-authors">{paper.data.authors.join(", ")}</p>
          <p>{paper.data.abstract}</p>
          <div class="research-brief">
            {paper.data.problem && (
              <div>
                <span class="panel-kicker">Problem</span>
                <p>{paper.data.problem}</p>
              </div>
            )}
            {paper.data.method && (
              <div>
                <span class="panel-kicker">Method</span>
                <p>{paper.data.method}</p>
              </div>
            )}
            {paper.data.contribution.length > 0 && (
              <div>
                <span class="panel-kicker">Contribution</span>
                <p>{paper.data.contribution[0]}</p>
              </div>
            )}
            {paper.data.nextStep && (
              <div>
                <span class="panel-kicker">Next public update</span>
                <p>{paper.data.nextStep}</p>
              </div>
            )}
          </div>
          <div class="tag-row">
            {paper.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
          <EvidenceBadges artifacts={paper.data.artifacts} />
          <div class="paper-actions">
            <a href={paperHref(paper)}>Details</a>
            {paper.data.pdf && <a href={paper.data.pdf}>PDF</a>}
            {paper.data.code && <a href={paper.data.code} target="_blank" rel="noopener noreferrer">Code</a>}
          </div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
