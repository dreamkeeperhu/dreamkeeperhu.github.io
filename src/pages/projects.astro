---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EvidenceBadges from "../components/EvidenceBadges.astro";
import { projectHref, projectSlug } from "../utils/content";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const statuses = ["all", ...new Set(projects.map((project) => project.data.status))];
const tags = [...new Set(projects.flatMap((project) => project.data.tags))].slice(0, 12);
---

<BaseLayout
  current="Projects"
  title="Projects | HJH"
  description="Selected projects by Jianheng Hu: research code, tools, website infrastructure, and robotics-adjacent experiments."
>
  <section class="content-hero">
    <span class="eyebrow">Projects</span>
    <h1>Code, prototypes, and experiment traces</h1>
    <p>Each project is treated as evidence: what problem it touches, how it is built, what is real today, and what it connects to.</p>
  </section>

  <section class="notes-tools project-tools" aria-label="Project filters">
    <label>Filter projects</label>
    <div class="filter-row" data-project-status>
      {statuses.map((status) => (
        <button type="button" data-status={status} aria-pressed={status === "all" ? "true" : "false"}>{status}</button>
      ))}
    </div>
    <div class="tool-links" data-project-tags>
      {tags.map((tag) => <button type="button" data-tag={tag}>{tag}</button>)}
    </div>
  </section>

  <section class="project-board" data-project-board>
    {projects.map((project, index) => (
      <article
        id={projectSlug(project)}
        class="project-item"
        data-project-row
        data-status={project.data.status}
        data-tags={project.data.tags.map((tag) => tag.toLowerCase()).join("|")}
        data-repo={project.data.repo}
      >
        <div class="project-index">{String(index + 1).padStart(2, "0")}</div>
        <div class="project-main">
          <div class="paper-meta">
            <span>{project.data.status}</span>
            <span>{project.data.statusDetail}</span>
            {project.data.thread && <span>{project.data.thread}</span>}
            {project.data.artifacts.length > 0 && <span>{project.data.artifacts.length} artifacts</span>}
            <span data-repo-meta>{project.data.repo ? "GitHub metadata loading" : "Curated project"}</span>
          </div>
          <h2><a href={projectHref(project)}>{project.data.title}</a></h2>
          <p>{project.data.summary}</p>
          {project.data.outcome && <p class="project-outcome"><strong>Outcome:</strong> {project.data.outcome}</p>}
          <div class="project-columns">
            <div>
              <span class="panel-kicker">Problem</span>
              <p>{project.data.problem}</p>
            </div>
            <div>
              <span class="panel-kicker">Method</span>
              <p>{project.data.method}</p>
            </div>
          </div>
          <div class="tag-row">{project.data.tags.map((tag) => <span>{tag}</span>)}</div>
          <EvidenceBadges artifacts={project.data.artifacts} />
          <div class="paper-actions">
            <a href={projectHref(project)}>Details</a>
            {project.data.url && <a href={project.data.url} target="_blank" rel="noreferrer">GitHub</a>}
            {project.data.links.map((link) => <a href={link.href}>{link.label}</a>)}
          </div>
        </div>
      </article>
    ))}
  </section>

  <script is:inline>
    const projectRows = [...document.querySelectorAll("[data-project-row]")];
    const statusButtons = [...document.querySelectorAll("[data-project-status] button")];
    const tagButtons = [...document.querySelectorAll("[data-project-tags] button")];
    let activeStatus = "all";
    let activeTag = "";

    statusButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeStatus = button.dataset.status || "all";
        statusButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        renderProjects();
      });
    });

    tagButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeTag = activeTag === button.dataset.tag ? "" : button.dataset.tag || "";
        tagButtons.forEach((item) => item.setAttribute("aria-pressed", String(item.dataset.tag === activeTag)));
        renderProjects();
      });
    });

    function renderProjects() {
      projectRows.forEach((row) => {
        const statusMatch = activeStatus === "all" || row.dataset.status === activeStatus;
        const tagMatch = !activeTag || (row.dataset.tags || "").split("|").includes(activeTag.toLowerCase());
        row.hidden = !(statusMatch && tagMatch);
      });
    }

    const repos = projectRows.map((row) => row.dataset.repo).filter(Boolean).map((repo) => `dreamkeeperhu/${repo}`);
    if (repos.length) fetch(`/api/github-repos?repos=${encodeURIComponent(repos.slice(0, 8).join(","))}`)
      .then((response) => (response.ok ? response.json() : null))
      .then((payload) => {
      const byName = new Map((payload?.repos || []).filter(Boolean).map((repo) => [repo.name, repo]));
      projectRows.forEach((row) => {
        const meta = row.querySelector("[data-repo-meta]");
        const repo = byName.get(row.dataset.repo);
        if (!meta) return;
        meta.textContent = repo
          ? `${repo.language || "Code"} · ${repo.stars ?? "?"} stars · ${repo.updatedAt ? `updated ${new Date(repo.updatedAt).toISOString().slice(0, 10)}` : repo.source}`
          : "Curated project";
      });
    }).catch(() => {});
  </script>
</BaseLayout>
