---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EvidencePanel from "../../components/EvidencePanel.astro";
import FeedbackForm from "../../components/FeedbackForm.astro";
import { paperHref, paperSlug } from "../../utils/content";
import { mergeArtifacts } from "../../utils/artifacts";
import { collectBacklinks } from "../../utils/relations";
import { profile } from "../../data/profile";

export async function getStaticPaths() {
  const papers = (await getCollection("papers")).filter((paper) => !paper.data.draft);
  return papers.map((paper) => ({ params: { slug: paperSlug(paper) }, props: { paper } }));
}

const { paper } = Astro.props;
const { Content } = await render(paper);
const title = `${paper.data.title} | HJH Research`;
const [allPapers, allProjects, allNotes, allLibrary] = await Promise.all([
  getCollection("papers", (item) => !item.data.draft),
  getCollection("projects", (item) => !item.data.draft),
  getCollection("notes", (item) => !item.data.draft),
  getCollection("library", (item) => !item.data.draft),
]);
const backlinks = collectBacklinks(paperHref(paper), {
  papers: allPapers,
  projects: allProjects,
  notes: allNotes,
  library: allLibrary,
});
const paperArtifacts = mergeArtifacts([
  ...paper.data.artifacts,
  paper.data.pdf && {
    label: "Paper PDF",
    type: "pdf",
    href: paper.data.pdf,
    description: "Public PDF attached to this research entry.",
    status: "available",
  },
  paper.data.code && {
    label: "Code repository",
    type: "code",
    href: paper.data.code,
    description: "Code or implementation workspace linked to this research entry.",
    status: "available",
  },
  ...paper.data.relatedProjects.map((href) => ({
    label: "Related project",
    type: "project",
    href,
    description: "Project trace connected to this paper.",
    status: "available",
  })),
  ...paper.data.relatedNotes.map((href) => ({
    label: "Related note",
    type: "note",
    href,
    description: "Public note connected to this paper.",
    status: "available",
  })),
]);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  headline: paper.data.title,
  name: paper.data.title,
  author: paper.data.authors.map((name) => ({ "@type": "Person", name })),
  datePublished: String(paper.data.year),
  abstract: paper.data.abstract,
  url: new URL(paperHref(paper), profile.site).toString(),
  ...(paper.data.pdf ? { encoding: { "@type": "MediaObject", contentUrl: new URL(paper.data.pdf, profile.site).toString() } } : {}),
};
---

<BaseLayout current="Research" title={title} description={paper.data.abstract} jsonLd={jsonLd} ogType="article">
  <article class="article-page research-detail">
    <header class="article-header">
      <a href="/research">← Research</a>
      <time>{paper.data.status} · {paper.data.year}</time>
      <h1>{paper.data.title}</h1>
      <p>{paper.data.abstract}</p>
      <div class="paper-meta">
        <span>{paper.data.authors.join(", ")}</span>
        {paper.data.venue && <span>{paper.data.venue}</span>}
      </div>
      <div class="tag-row">{paper.data.tags.map((tag) => <span>{tag}</span>)}</div>
      <div class="paper-actions">
        {paper.data.pdf && <a href={paper.data.pdf}>PDF</a>}
        {paper.data.code && <a href={paper.data.code} target="_blank" rel="noreferrer">Code</a>}
        {paper.data.relatedProjects.map((href) => <a href={href}>Project</a>)}
        {paper.data.relatedNotes.map((href) => <a href={href}>Related note</a>)}
      </div>
    </header>
    <div class="detail-grid archive-detail-grid">
      {paper.data.problem && (
        <section>
          <span class="panel-kicker">Problem</span>
          <p>{paper.data.problem}</p>
        </section>
      )}
      {paper.data.method && (
        <section>
          <span class="panel-kicker">Method</span>
          <p>{paper.data.method}</p>
        </section>
      )}
      {paper.data.evidence.length > 0 && (
        <section>
          <span class="panel-kicker">Evidence</span>
          <ul>{paper.data.evidence.map((item) => <li>{item}</li>)}</ul>
        </section>
      )}
      {paper.data.nextStep && (
        <section>
          <span class="panel-kicker">Next</span>
          <p>{paper.data.nextStep}</p>
        </section>
      )}
    </div>
    <EvidencePanel artifacts={paperArtifacts} bibtex={paper.data.bibtex} />
    <div class="article-body">
      <Content />
      {(paper.data.relatedProjects.length > 0 || paper.data.relatedNotes.length > 0 || paper.data.relatedLibrary.length > 0) && (
        <section class="related-block">
          <h2>Related</h2>
          <div class="inline-links">
            {paper.data.relatedProjects.map((href) => <a href={href}>Project</a>)}
            {paper.data.relatedNotes.map((href) => <a href={href}>Note</a>)}
            {paper.data.relatedLibrary.map((href) => <a href={href}>Library</a>)}
          </div>
        </section>
      )}
      {backlinks.length > 0 && (
        <section class="related-block">
          <h2>Referenced By</h2>
          <div class="inline-links">
            {backlinks.map((link) => <a href={link.href}>{link.type}: {link.title}</a>)}
          </div>
        </section>
      )}
      <FeedbackForm targetType="paper" targetTitle={paper.data.title} targetUrl={paperHref(paper)} />
    </div>
  </article>
</BaseLayout>
