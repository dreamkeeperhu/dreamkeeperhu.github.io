# Default Notion integration.
# Create an internal Notion integration, share your content databases with it,
# then set either DATA_SOURCE_ID values directly or DATABASE_ID values and let
# the sync script pick the first data source under each database.
NOTION_API_KEY=
NOTION_VERSION=2026-03-11
NOTION_NOTES_DATA_SOURCE_ID=
NOTION_NOTES_DATABASE_ID=
NOTION_PAPERS_DATA_SOURCE_ID=
NOTION_PAPERS_DATABASE_ID=
NOTION_SYNC_DRAFTS=false
NOTION_CLEAN_SYNC=true

# Optional Obsidian fallback.
# Point this to your local Obsidian vault if you want to sync selected folders.
OBSIDIAN_VAULT_PATH=
OBSIDIAN_NOTES_DIR=Notes
OBSIDIAN_PAPERS_DIR=Papers
OBSIDIAN_SYNC_DRAFTS=false
OBSIDIAN_CLEAN_SYNC=true

# Optional newsletter provider endpoint. Without this, the form falls back to mailto.
PUBLIC_SUBSCRIBE_ACTION=

# Optional privacy-friendly analytics.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=

# Optional image CDN prefix, for example a Cloudflare R2 public bucket.
PUBLIC_ASSET_CDN=
