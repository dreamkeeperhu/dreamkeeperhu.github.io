# Default Obsidian integration.
# Point this to a local vault and keep private journal folders out of the
# publish folders. Cloudflare Pages can leave this empty; local deploys can
# build after syncing selected public notes.
OBSIDIAN_VAULT_PATH=
OBSIDIAN_NOTES_DIR=Homepage/Notes
OBSIDIAN_PAPERS_DIR=Homepage/Papers
OBSIDIAN_SYNC_DRAFTS=false
OBSIDIAN_CLEAN_SYNC=true

# Optional newsletter provider endpoint. Without this, the form falls back to mailto.
PUBLIC_SUBSCRIBE_ACTION=

# Optional privacy-friendly analytics.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=

# Optional image CDN prefix, for example a Cloudflare R2 public bucket.
PUBLIC_ASSET_CDN=
