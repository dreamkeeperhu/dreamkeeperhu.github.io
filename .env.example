# Optional Obsidian integration.
# Point this to your local Obsidian vault. During build, matching notes are
# copied into Astro content collections. In Cloudflare Pages, leave this empty
# unless the vault is committed into the repo or mounted during build.
OBSIDIAN_VAULT_PATH=
OBSIDIAN_NOTES_DIR=Notes
OBSIDIAN_PAPERS_DIR=Papers
OBSIDIAN_SYNC_DRAFTS=false
OBSIDIAN_CLEAN_SYNC=true

# Optional newsletter provider endpoint. Without this, the form falls back to mailto.
PUBLIC_SUBSCRIBE_ACTION=

# Optional privacy-friendly analytics.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=

# Optional image CDN prefix, for example a Cloudflare R2 public bucket.
PUBLIC_ASSET_CDN=
